[Unit]
Description=Apply power profile and battery thresholds
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/power-switch.sh
ExecStart=/bin/bash -c 'echo 80 > /sys/class/power_supply/BAT0/charge_control_end_threshold && echo 75 > /sys/class/power_supply/BAT0/charge_control_start_threshold'

[Install]
WantedBy=multi-user.target
